    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.58.0",
    "node-forge": "^1.3.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
